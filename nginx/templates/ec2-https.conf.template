server_names_hash_bucket_size 128;
log_format orderrun '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" "$http_x_forwarded_for"';
error_log /var/log/nginx/error.log warn;

# 평문 HTTP와 미지정 host(IP 직접 접근 포함). API를 서빙하지 않고 HTTPS로 넘긴다.
# 308을 쓰는 이유: 301/302는 다수의 클라이언트가 POST를 GET으로 바꾸며 본문을 버린다.
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name ${EC2_PUBLIC_IP} _;
    access_log /var/log/nginx/staging-access.log orderrun;

    # certbot HTTP-01 갱신 경로. 리다이렉트하면 인증서 갱신이 실패한다.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 308 https://${STAGING_DOMAIN}$request_uri;
    }
}

server {
    listen 80;
    listen [::]:80;
    server_name ${PROD_DOMAIN} ${STAGING_DOMAIN};
    access_log /var/log/nginx/redirect-access.log orderrun;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name ${PROD_DOMAIN};
    access_log /var/log/nginx/prod-access.log orderrun;

    ssl_certificate /etc/letsencrypt/live/${PROD_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${PROD_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    client_max_body_size 10m;

    # always를 붙여 4xx/5xx 응답에도 실리게 한다.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;

    # 채팅 실시간 연결(WebSocket, CHAT-REQ-015). 받기 전용이고 서버가 30초마다 ping을 보내므로
    # read timeout을 길게 둔다. Upgrade·Connection 헤더가 없으면 일반 HTTP로 넘어가 연결이 안 된다.
    location = /v1/chat/ws {
        proxy_pass http://app-prod:8000;
        proxy_http_version 1.1;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 5s;
        proxy_send_timeout 3600s;
        proxy_read_timeout 3600s;
    }

    location / {
        proxy_pass http://app-prod:8000;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 5s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name ${STAGING_DOMAIN};
    access_log /var/log/nginx/staging-access.log orderrun;

    ssl_certificate /etc/letsencrypt/live/${PROD_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${PROD_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    client_max_body_size 10m;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;

    # staging은 APP_ENV=staging이라 앱이 API 문서를 그대로 노출한다. 클라이언트 개발자는
    # 계속 봐야 하므로 없애지 않고 basic auth를 건다. 프로덕션은 앱이 이미 404를 낸다.
    # Swagger UI가 /openapi.json을 XHR로 부르므로 세 경로에 같은 realm으로 걸어야
    # 브라우저가 자격증명을 재사용한다.
    location ~ ^/(docs|redoc|openapi\.json)$ {
        auth_basic "OrderRun staging docs";
        auth_basic_user_file /etc/nginx/htpasswd;

        # add_header는 이 블록에서 다시 선언하지 않으면 상위 값이 상속되지 않는다.
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "no-referrer" always;

        proxy_pass http://app-staging:8000;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 5s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    # 채팅 실시간 연결(WebSocket, CHAT-REQ-015). 받기 전용이고 서버가 30초마다 ping을 보내므로
    # read timeout을 길게 둔다. Upgrade·Connection 헤더가 없으면 일반 HTTP로 넘어가 연결이 안 된다.
    location = /v1/chat/ws {
        proxy_pass http://app-staging:8000;
        proxy_http_version 1.1;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 5s;
        proxy_send_timeout 3600s;
        proxy_read_timeout 3600s;
    }

    location / {
        proxy_pass http://app-staging:8000;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 5s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
}
