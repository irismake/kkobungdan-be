log_format orderrun '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" "$http_x_forwarded_for"';
error_log /var/log/nginx/error.log warn;

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name ${EC2_PUBLIC_IP} _;
    access_log /var/log/nginx/staging-access.log orderrun;

    client_max_body_size 10m;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # 채팅 실시간 연결(WebSocket, CHAT-REQ-015). 받기 전용이고 서버가 30초마다 ping을 보내므로
    # read timeout을 길게 둔다. Upgrade·Connection 헤더가 없으면 일반 HTTP로 넘어가 연결이 안 된다.
    location = /v1/chat/ws {
        proxy_pass http://app:8000;
        proxy_http_version 1.1;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 5s;
        proxy_send_timeout 3600s;
        proxy_read_timeout 3600s;
    }

    location / {
        proxy_pass http://app:8000;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 5s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
}
